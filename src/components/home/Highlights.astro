---
import { getCollection } from "astro:content";
import ButtonLink from "../ui/ButtonLink.astro";
import Icon from "../ui/Icon.astro";

const cards = (await getCollection("destacados")).sort((a, b) => a.data.order - b.data.order);

const colorClass = {
  roast: "bg-roast",
  henequen: "bg-henequen",
  rosa: "bg-rosa",
  orange: "bg-orange",
} as const;
---

<section class="relative z-10 -mt-[14vh] pb-[5rem] xl:-mt-[26vh]">
  <div class="mx-auto grid w-[94%] grid-cols-1 gap-[1.5rem] sm:grid-cols-2 xl:grid-cols-4">
    {
      cards.map(({ data: card }) => (
        <article
          class:list={[
            "flex flex-col items-center border-[0.6rem] border-cream px-[8%] pb-[5.4rem] pt-[5.2rem] text-center text-cream",
            colorClass[card.color],
          ]}
        >
          <p class="font-display text-[clamp(1.1rem,1.3vw,1.4rem)] uppercase leading-none tracking-wide">
            {card.kicker}
          </p>
          <h2 class="mt-[0.7rem] font-display text-[clamp(2.4rem,3.2vw,3.6rem)] uppercase leading-[1.05]">
            {card.title}
          </h2>

          <div class="my-[4.2rem] flex aspect-square w-[62%] items-center justify-center rounded-[1rem] bg-black/20">
            <Icon name={card.icon} class="w-[55%]" />
          </div>

          <p class="mb-[4.4rem] font-body text-[clamp(1.05rem,1.15vw,1.25rem)] leading-relaxed">
            {card.text}
          </p>

          <ButtonLink href={card.href} class="mt-auto">{card.cta}</ButtonLink>
        </article>
      ))
    }
  </div>
</section>
