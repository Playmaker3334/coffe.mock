---
import { Image } from "astro:assets";
import hero from "../../assets/images/hero/hero.jpg";
import { site } from "../../config/site";
---

<section class="relative w-full overflow-hidden bg-ink">
  <Image
    src={hero}
    alt={site.hero.alt}
    widths={[640, 960, 1280, 1920, 2560]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="h-[calc(100dvh-var(--header-h,5rem))] min-h-[20rem] w-full object-cover"
  />
</section>
