---
import { Image } from "astro:assets";
import { getEntry, render } from "astro:content";

const entry = await getEntry("secciones", "por-que-elegirnos");
if (!entry) throw new Error("Falta src/content/secciones/por-que-elegirnos.md");

const { data } = entry;
const { image, alt } = data;
if (!image || !alt) throw new Error("por-que-elegirnos.md necesita image y alt");
const { Content } = await render(entry);
---

<section class="overflow-x-clip py-[5rem] lg:py-[7rem]">
  <div class="mx-auto grid w-[90%] grid-cols-1 items-center gap-[4rem] lg:grid-cols-2 lg:gap-[5%]">
    <div class="relative mx-auto mt-[3rem] w-[58%] max-w-[24rem] lg:mt-0">
      <svg
        class="pointer-events-none absolute left-[-30%] top-[-28.6%] w-[165.7%] text-sand"
        viewBox="-112 -110 232 212"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M-78 -28h156v68a40 40 0 0 1-40 40h-76a40 40 0 0 1-40-40z"></path>
        <circle cx="88" cy="12" r="22" fill="none" stroke="currentColor" stroke-width="11"></circle>
        <ellipse cx="0" cy="88" rx="108" ry="11"></ellipse>
        <g fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round">
          <path d="M52 -42c-10-12 10-20 0-34c-8-11 6-18 2-26"></path>
          <path d="M72 -38c-10-12 10-20 0-34c-8-11 6-18 2-26"></path>
        </g>
      </svg>
      <div class="absolute inset-0 translate-x-[4%] translate-y-[3%] rounded-full bg-sun" aria-hidden="true"></div>
      <Image
        src={image}
        alt={alt}
        widths={[400, 640, 960, 1280]}
        sizes="(min-width: 64rem) 24rem, 58vw"
        class="relative aspect-square w-full rounded-full object-cover"
      />
    </div>

    <div>
      <p class="font-display text-[clamp(1.2rem,1.8vw,1.9rem)] uppercase leading-none tracking-wide text-chili">
        {data.kicker}
      </p>
      <h2 class="mt-[0.9rem] font-display text-[clamp(3rem,6vw,6.2rem)] uppercase leading-[1.05] text-ink">
        {data.title}
      </h2>
      <div class="mt-[1.6rem] flex flex-col gap-[1.4rem] font-body text-[clamp(1.1rem,1.4vw,1.55rem)] leading-relaxed text-ink">
        <Content />
      </div>
    </div>
  </div>
</section>
