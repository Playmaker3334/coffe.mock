---
import { Image } from "astro:assets";
import thinking from "../../assets/images/elegirnos/thinking.jpg";
import { site } from "../../config/site";

const { whyUs } = site;
---

<section class="py-[5rem] lg:py-[7rem]">
  <div class="mx-auto grid w-[90%] grid-cols-1 items-center gap-[3rem] lg:grid-cols-2 lg:gap-[5%]">
    <div class="relative mx-auto w-[85%] max-w-[36rem] lg:w-[90%]">
      <div class="absolute inset-0 translate-x-[4%] translate-y-[3%] rounded-full bg-sun" aria-hidden="true"></div>
      <Image
        src={thinking}
        alt={whyUs.alt}
        widths={[400, 640, 960, 1280]}
        sizes="(min-width: 64rem) 40vw, 85vw"
        class="relative aspect-square w-full rounded-full object-cover"
      />
    </div>

    <div>
      <p class="font-display text-[clamp(1.2rem,1.8vw,1.9rem)] uppercase leading-none tracking-wide text-chili">
        {whyUs.kicker}
      </p>
      <h2 class="mt-[0.9rem] font-display text-[clamp(3rem,6vw,6.2rem)] uppercase leading-[1.05] text-ink">
        {whyUs.title}
      </h2>
      <div class="mt-[1.6rem] flex flex-col gap-[1.4rem] font-body text-[clamp(1.1rem,1.4vw,1.55rem)] leading-relaxed text-ink">
        {whyUs.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </div>
</section>
