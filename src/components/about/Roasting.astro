---
import { loadSection } from "../../utils/content";
import Silhouette from "../ui/Silhouette.astro";
import TextBlock from "../ui/TextBlock.astro";
import TornPanel from "../ui/TornPanel.astro";

const { data, Content } = await loadSection("nosotros-tostado");
---

<section id="tostado-en-casa" class="scroll-mt-[calc(var(--header-h,5rem)+3rem)] py-[2.5rem] lg:py-[3rem]">
  <TornPanel
    tone="stone"
    seed={21}
    class="mx-auto w-[94%]"
    bodyClass="grid grid-cols-1 items-center gap-[2.5rem] px-[6%] py-[3rem] lg:grid-cols-[1.2fr_1fr] lg:gap-[5%] lg:py-[3.5rem]"
  >
    <TextBlock kicker={data.kicker} title={data.title} kickerClass="text-terracotta" cta={data.cta} href={data.href}>
      <Content />
    </TextBlock>
    <Silhouette name="tostador" cutClass="text-stone" class="mx-auto w-[60%] max-w-[20rem]" />
  </TornPanel>
</section>
