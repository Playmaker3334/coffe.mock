---
import { site } from "../../config/site";
import { loadSection } from "../../utils/content";
import Silhouette from "../ui/Silhouette.astro";
import TextBlock from "../ui/TextBlock.astro";
import TornPanel from "../ui/TornPanel.astro";

const { data, Content } = await loadSection("nosotros-pregunta");
---

<section class="pb-[1.5rem] pt-[2.5rem] lg:pt-[3rem]">
  <TornPanel
    tone="bright"
    seed={73}
    tilt={-5}
    class="mx-auto w-[94%]"
    bodyClass="grid grid-cols-1 items-center gap-[2.5rem] px-[6%] py-[3rem] lg:grid-cols-[1.2fr_1fr] lg:gap-[5%] lg:py-[3.5rem]"
  >
    <TextBlock
      kicker={data.kicker}
      title={data.title}
      kickerClass="text-terracotta"
      cta={data.cta}
      href={site.contact.whatsapp}
      tone="ink"
      external
    >
      <Content />
    </TextBlock>
    <Silhouette name="charla" cutClass="text-bright" class="mx-auto w-[60%] max-w-[19rem]" />
  </TornPanel>
</section>
