---
import { loadSection } from "../../utils/content";
import Illustration from "../ui/Illustration.astro";
import TextBlock from "../ui/TextBlock.astro";
import TornPanel from "../ui/TornPanel.astro";

const { data, Content } = await loadSection("tienda-historia");
---

<section data-hide-when-filtering class="py-[4.5rem] lg:py-[5.5rem]">
  <TornPanel
    tone="sage"
    seed={31}
    tilt={-5}
    class="mx-auto w-[94%]"
    bodyClass="grid grid-cols-1 items-center gap-[2.5rem] px-[6%] py-[3rem] lg:grid-cols-[1.2fr_1fr] lg:gap-[5%] lg:py-[3.5rem]"
  >
    <TextBlock
      kicker={data.kicker}
      title={data.title}
      kickerClass="text-bright"
      titleClass="text-cream"
      bodyClass="text-cream"
      cta={data.cta}
      href={data.href}
    >
      <Content />
    </TextBlock>
    <div class="mx-auto flex aspect-square w-[70%] items-center justify-center rounded-[2rem] bg-ink lg:w-[80%]">
      <Illustration name="coffeeBag" blobClass="text-mustard" lineClass="text-cream" class="w-[60%]" />
    </div>
  </TornPanel>
</section>
