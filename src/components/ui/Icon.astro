---
import { icons, type IconName } from "./icons";

interface Props {
  name: IconName;
  class?: string;
  strokeWidth?: number;
}

const { name, class: className, strokeWidth } = Astro.props;
const icon = icons[name];
const isStroke = icon.mode === "stroke";
---

<svg
  class={className}
  viewBox={icon.viewBox}
  fill={isStroke ? "none" : "currentColor"}
  stroke={isStroke ? "currentColor" : undefined}
  stroke-width={isStroke ? (strokeWidth ?? icon.strokeWidth) : undefined}
  stroke-linecap={isStroke ? "round" : undefined}
  stroke-linejoin={isStroke ? "round" : undefined}
  aria-hidden="true"
  set:html={icon.body}
/>
