---
import { illustrations, type IllustrationName } from "./illustrations";

interface Props {
  name: IllustrationName;
  blobClass: string;
  lineClass?: string;
  class?: string;
}

const { name, blobClass, lineClass = "text-ink", class: className } = Astro.props;
const { viewBox, blob, lines, dots = [] } = illustrations[name];
---

<svg class={className} viewBox={viewBox} aria-hidden="true">
  <path d={blob} fill="currentColor" class={blobClass}></path>
  <g class={lineClass}>
    <g fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round">
      {lines.map((d) => <path d={d} />)}
    </g>
    {dots.map((dot) => <circle cx={dot.cx} cy={dot.cy} r={dot.r} fill="currentColor" />)}
  </g>
</svg>
