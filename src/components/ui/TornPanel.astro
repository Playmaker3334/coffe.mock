---
import TornEdge from "./TornEdge.astro";

export type PanelTone = "teal" | "stone" | "mustard" | "sage" | "bright";

interface Props {
  tone: PanelTone;
  seed: number;
  tilt?: number;
  id?: string;
  class?: string;
  bodyClass?: string;
}

const { tone, seed, tilt = 6, id, class: className, bodyClass } = Astro.props;

const toneClass = {
  teal: { fill: "text-teal", bg: "bg-teal" },
  stone: { fill: "text-stone", bg: "bg-stone" },
  mustard: { fill: "text-mustard", bg: "bg-mustard" },
  sage: { fill: "text-sage", bg: "bg-sage" },
  bright: { fill: "text-bright", bg: "bg-bright" },
} as const;

const t = toneClass[tone];
---

<div id={id} class:list={["relative", className]}>
  <TornEdge width={1400} seed={seed} tilt={tilt} flecks class:list={["max-md:hidden", t.fill]} />
  <TornEdge width={1400} seed={seed + 1} tilt={-tilt / 3} side="bottom" class:list={["max-md:hidden", t.fill]} />
  <TornEdge width={500} seed={seed + 2} tilt={tilt / 2} flecks class:list={["md:hidden", t.fill]} />
  <TornEdge width={500} seed={seed + 3} tilt={-tilt / 4} side="bottom" class:list={["md:hidden", t.fill]} />
  <div class:list={["relative", t.bg, bodyClass]}>
    <slot />
  </div>
</div>
