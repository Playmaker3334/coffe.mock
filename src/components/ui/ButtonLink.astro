---
import { withBase } from "../../utils/url";
import Bean from "./Bean.astro";

interface Props {
  href: string;
  class?: string;
}

const { href, class: className } = Astro.props;
---

<a
  href={withBase(href)}
  class:list={[
    "inline-flex items-center gap-[0.6rem] bg-sun px-[1.4rem] py-[0.7rem] font-display text-[clamp(1.15rem,1.3vw,1.4rem)] uppercase tracking-wide text-ink [--btn-bg:var(--color-sun)] hover:bg-ink hover:text-sun hover:[--btn-bg:var(--color-ink)] focus-visible:bg-ink focus-visible:text-sun focus-visible:[--btn-bg:var(--color-ink)]",
    className,
  ]}
>
  <Bean class="size-4" crease="var(--btn-bg)" />
  <slot />
  <Bean class="size-4" crease="var(--btn-bg)" />
</a>
