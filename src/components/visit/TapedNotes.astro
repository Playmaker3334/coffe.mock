---
import { getCollection } from "astro:content";
import { site } from "../../config/site";
import ButtonLink from "../ui/ButtonLink.astro";
import Note from "../ui/Note.astro";

const notes = (await getCollection("notas")).sort((a, b) => a.data.order - b.data.order);
---

<section aria-label="Más opciones" class="mx-auto grid w-[90%] grid-cols-1 gap-[4rem] pb-[3rem] pt-[5.5rem] lg:grid-cols-2 lg:gap-[5%]">
  {
    notes.map(({ data: note }, i) => (
      <Note tone={note.tone} tilt={i % 2 === 0 ? "left" : "right"} illustration={note.illustration} illustrationColor={note.illustrationColor}>
        <p class="font-display text-[clamp(1.05rem,1.2vw,1.3rem)] lg:text-[clamp(0.95rem,1.08vw,1.17rem)] uppercase leading-none tracking-wide text-sand">
          {note.kicker}
        </p>
        <h2 class="mt-[0.7rem] font-display text-[clamp(2.2rem,3vw,3.2rem)] lg:text-[clamp(1.98rem,2.7vw,2.88rem)] uppercase leading-[1.05]">
          {note.title}
        </h2>
        <p class="mt-[1rem] font-body text-[clamp(1.02rem,1.1vw,1.2rem)] lg:text-[clamp(0.95rem,1vw,1.1rem)] leading-relaxed">
          {note.text}
        </p>
        <ButtonLink
          href={note.whatsapp ? site.contact.whatsapp : (note.href ?? "/")}
          tone={note.tone === "ink" ? "dark" : "light"}
          external={note.whatsapp}
          class="mt-[1.6rem]"
        >
          {note.cta}
        </ButtonLink>
      </Note>
    ))
  }
</section>
