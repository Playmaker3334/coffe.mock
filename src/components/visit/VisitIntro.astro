---
import { getEntry, render } from "astro:content";
import Polaroid from "../ui/Polaroid.astro";

const entry = await getEntry("secciones", "donde-encontrarnos");
if (!entry) throw new Error("Falta src/content/secciones/donde-encontrarnos.md");

const { data } = entry;
const { image, alt } = data;
if (!image || !alt) throw new Error("donde-encontrarnos.md necesita image y alt");
const { Content } = await render(entry);
---

<section class="pb-[2.5rem] pt-[4rem] lg:pt-[5rem]">
  <div class="mx-auto grid w-[90%] grid-cols-1 items-center gap-[3.5rem] lg:grid-cols-[1.15fr_1fr] lg:gap-[5%]">
    <div>
      <p class="font-display text-[clamp(1.2rem,1.8vw,1.9rem)] lg:text-[clamp(1.08rem,1.62vw,1.71rem)] uppercase leading-none tracking-wide text-chili">
        {data.kicker}
      </p>
      <h1 class="mt-[0.9rem] font-display text-[clamp(3rem,6vw,6.2rem)] lg:text-[clamp(2.7rem,5.4vw,5.58rem)] uppercase leading-[1.05] text-ink">
        {data.title}
      </h1>
      <div class="mt-[1.6rem] max-w-[36rem] font-body text-[clamp(1.1rem,1.4vw,1.55rem)] lg:text-[clamp(0.99rem,1.26vw,1.395rem)] leading-relaxed text-ink">
        <Content />
      </div>
    </div>

    <Polaroid image={image} alt={alt} caption={data.caption} class="mx-auto w-[85%] max-w-[32rem] lg:w-[90%]" />
  </div>
</section>
