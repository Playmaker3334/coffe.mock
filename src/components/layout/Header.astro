---
import { site } from "../../config/site";
import { withBase } from "../../utils/url";
import Bean from "../ui/Bean.astro";
import Icon from "../ui/Icon.astro";
import Logo from "./Logo.astro";
import MobileNav from "./MobileNav.astro";
---

<header data-site-header class="sticky top-0 z-40 bg-ink text-cream">
  <div class="mx-auto flex w-[94%] items-center justify-between gap-[3%] py-[1.2rem] lg:py-[1.08rem] xl:py-[1.35rem]">
    <Logo />

    <nav aria-label="Principal" class="hidden flex-1 items-center justify-center gap-[1.4%] xl:flex">
      <Bean class="size-[1.575rem] text-amber" />
      {
        site.nav.primary.map((item, i) => (
          <>
            {i > 0 && <Bean class="size-[1.125rem] text-leaf" />}
            <a
              href={withBase(item.href)}
              class="whitespace-nowrap font-display text-[clamp(1.44rem,1.98vw,2.43rem)] uppercase leading-none tracking-wide transition-colors hover:text-sun"
            >
              {item.label}
            </a>
          </>
        ))
      }
      <Bean class="size-[1.575rem] text-amber" />
    </nav>

    <div class="flex items-center gap-[1.2rem]">
      <a href={withBase("/cuenta")} aria-label="Cuenta" class="hidden transition-colors hover:text-sun xl:block">
        <Icon name="user" class="size-[1.8rem]" />
      </a>

      <button type="button" aria-label="Buscar" class="hidden transition-colors hover:text-sun xl:block">
        <Icon name="search" class="size-[1.8rem]" />
      </button>

      <a
        href={withBase("/carrito")}
        aria-label={`Carrito, ${site.cartCount} artículos`}
        class="relative mr-[1.6rem] lg:mr-[1.44rem] transition-colors hover:text-sun"
      >
        <Icon name="cart" class="size-9 lg:size-[2.025rem]" />
        <span class="absolute -right-[1.6rem] -top-[0.7rem] font-display text-[1.6rem] lg:-right-[1.44rem] lg:-top-[0.63rem] lg:text-[1.44rem] leading-none text-amber">
          ({site.cartCount})
        </span>
      </a>

      <button
        type="button"
        data-menu-open
        aria-controls="mobile-nav"
        aria-expanded="false"
        aria-label="Abrir menú"
        class="transition-colors hover:text-sun xl:hidden"
      >
        <Icon name="menu" class="size-8" />
      </button>
    </div>
  </div>
</header>

<MobileNav />

<script>
  const header = document.querySelector("[data-site-header]");

  if (header instanceof HTMLElement) {
    const update = () =>
      document.documentElement.style.setProperty("--header-h", `${header.offsetHeight}px`);
    new ResizeObserver(update).observe(header);
    update();
  }

  document.querySelectorAll<HTMLAnchorElement>("[data-home-link]").forEach((link) =>
    link.addEventListener("click", (event) => {
      const trim = (path: string) => path.replace(/\/+$/, "");
      if (trim(new URL(link.href).pathname) === trim(window.location.pathname)) {
        event.preventDefault();
        window.scrollTo({ top: 0, behavior: "smooth" });
      }
    }),
  );
</script>
