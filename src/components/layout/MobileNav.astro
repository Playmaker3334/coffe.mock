---
import { site } from "../../config/site";
import { withBase } from "../../utils/url";
import Bean from "../ui/Bean.astro";
import Icon from "../ui/Icon.astro";
import Logo from "./Logo.astro";

const current = Astro.url.pathname.replace(/\/$/, "");
const isActive = (href: string) => withBase(href).replace(/\/$/, "") === current;
---

<dialog
  id="mobile-nav"
  aria-label="Menú"
  class="m-0 h-dvh max-h-none w-full max-w-none border-0 bg-ink p-0 text-cream"
>
  <div class="mx-auto flex min-h-full w-[88%] flex-col py-[1.5rem]">
    <div class="flex items-center justify-between">
      <Logo />
      <button
        type="button"
        data-menu-close
        class="flex items-center gap-[0.6rem] font-display text-[clamp(1.8rem,7vw,2.4rem)] uppercase leading-none"
      >
        Cerrar
        <Icon name="close" class="size-8 text-chili" />
      </button>
    </div>

    <form role="search" data-mock-search class="mt-[2.5rem]">
      <label
        for="mobile-search"
        class="flex items-center gap-[0.5rem] font-display text-[clamp(1.6rem,6vw,2.1rem)] uppercase leading-none"
      >
        <Icon name="search" class="size-5 text-leaf" strokeWidth={3.5} />
        Buscar
      </label>
      <div class="mt-[0.6rem] flex bg-cream p-[0.35rem]">
        <input
          id="mobile-search"
          type="search"
          name="q"
          placeholder="Escribe tu búsqueda"
          class="w-[65%] bg-transparent px-[0.6rem] font-body text-ink placeholder:text-ink/50 focus:outline-none"
        />
        <button type="submit" class="w-[35%] bg-leaf py-[0.6rem] font-body font-bold uppercase text-cream">
          Buscar
        </button>
      </div>
    </form>

    <nav aria-label="Menú móvil" class="mt-[2.5rem]">
      <ul class="flex flex-col gap-[0.4rem]">
        <li>
          <a
            href={withBase("/carrito")}
            class="flex items-center gap-[0.7rem] font-display text-[clamp(1.9rem,8vw,2.6rem)] uppercase leading-[1.15] transition-colors hover:text-sun"
          >
            <Icon name="cart" class="size-5 text-leaf" strokeWidth={3} />
            Carrito
            <span class="text-[0.7em] text-amber">({site.cartCount})</span>
          </a>
        </li>
        {
          site.nav.primary.map((item) => (
            <li>
              <a
                href={withBase(item.href)}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "flex items-center gap-[0.7rem] font-display text-[clamp(1.9rem,8vw,2.6rem)] uppercase leading-[1.15] transition-colors hover:text-sun",
                  isActive(item.href) && "text-sun",
                ]}
              >
                <Bean class="size-5 text-leaf" />
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</dialog>

<script>
  const dialog = document.getElementById("mobile-nav");

  if (dialog instanceof HTMLDialogElement) {
    const openers = document.querySelectorAll("[data-menu-open]");

    const setExpanded = (value: boolean) =>
      openers.forEach((button) => button.setAttribute("aria-expanded", String(value)));

    openers.forEach((button) =>
      button.addEventListener("click", () => {
        dialog.showModal();
        document.documentElement.style.overflow = "hidden";
        setExpanded(true);
      }),
    );

    dialog.querySelector("[data-menu-close]")?.addEventListener("click", () => dialog.close());
    dialog.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => dialog.close()));
    dialog.querySelector("[data-mock-search]")?.addEventListener("submit", (event) => event.preventDefault());

    dialog.addEventListener("close", () => {
      document.documentElement.style.overflow = "";
      setExpanded(false);
    });

    window.matchMedia("(min-width: 80rem)").addEventListener("change", (event) => {
      if (event.matches && dialog.open) dialog.close();
    });
  }
</script>
